# Copy to `.env` only for local Compose usage.
#
# Keep this file small: service ports, default runtime selection, common model
# keys, enterprise integration endpoints, and local seed controls. Put real
# datasource details in `deploy/docker/agent/datasources.yml`, and real model
# provider/API-key details in `deploy/docker/agent/models.yml`.

# ---------------------------------------------------------------------------
# Service ports and compose-managed PostgreSQL
# ---------------------------------------------------------------------------
DATUS_BIND_ADDRESS=127.0.0.1
DATUS_POSTGRES_PASSWORD=datus
DATUS_POSTGRES_PORT=55433
DATUS_API_PORT=8000
DATUS_USERINFO_PORT=8010
DATUS_WEB_PORT=5173

# ---------------------------------------------------------------------------
# Runtime selection
# ---------------------------------------------------------------------------
# Defaults point to the compose-managed sample datasource. For multiple or
# external datasources:
#   cp deploy/docker/agent/datasources.example.yml deploy/docker/agent/datasources.yml
#   edit deploy/docker/agent/datasources.yml
#   set DATUS_DATASOURCE=<one datasource key>
DATUS_DATASOURCE=ccks_fund
DATUS_DATASOURCES_FILE=/run/datus/agent/datasources.yml
DATUS_DEV_ACCESS_TOKEN=dev-alice-token

# ---------------------------------------------------------------------------
# Model selection
# ---------------------------------------------------------------------------
# Provider/model selection uses the catalog plus deploy/docker/agent/models.yml.
# To configure multiple providers or private models:
#   cp deploy/docker/agent/models.example.yml deploy/docker/agent/models.yml
#   edit deploy/docker/agent/models.yml
#
# Catalog provider example:
#   DATUS_TARGET_PROVIDER=openai
#   DATUS_TARGET_MODEL=<your-model-name>
#
# Custom model entry example:
#   DATUS_TARGET=my_private_model
#   DATUS_TARGET_PROVIDER=
#   DATUS_TARGET_MODEL=
#
# Embedding is separate from the active chat/reasoning model. Docker Compose
# storage uses `target_model: ${DATUS_EMBEDDING_MODEL_KEY}`; configure the
# matching `models.<key>` entry in models.yml when changing this value.
DATUS_MODELS_FILE=/run/datus/agent/models.yml
DATUS_TARGET=
DATUS_TARGET_PROVIDER=deepseek
DATUS_TARGET_MODEL=deepseek-v4-flash
DATUS_EMBEDDING_MODEL_KEY=compose_embedding
DATUS_EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
DATUS_EMBEDDING_DIM_SIZE=1024

# ---------------------------------------------------------------------------
# Enterprise auth and RBAC stores
# ---------------------------------------------------------------------------
# Leave empty to use the compose mock userinfo service. Set this to your gateway
# or IdP userinfo endpoint when integrating with an enterprise identity system.
DATUS_ENTERPRISE_USERINFO_URL=

# Leave empty to use the compose PostgreSQL `datus_enterprise` database for
# users, roles, datasource grants, sessions, artifact ACLs, audit, quotas, and
# secret references. Set to an external PostgreSQL DSN to integrate with an
# existing permission/metadata database.
DATUS_ENTERPRISE_PG_DSN=

# Local Compose generates these two secrets once inside the persistent
# datus-agent-data volume when both are empty. Set both explicitly for any
# environment whose encrypted credential data must be backed up and restored.
# DATUS_USER_MODEL_CREDENTIAL_SECRET=
# DATUS_USER_DATASOURCE_SECRET=

# If the enterprise userinfo payload uses different field names, add the
# DATUS_AUTH_* overrides documented in DEVELOPMENT_DEPLOYMENT_GUIDE.zh.md.

# ---------------------------------------------------------------------------
# Local RBAC/datasource-grant seed
# ---------------------------------------------------------------------------
# Use a comma-separated list when granting multiple datasource keys:
#   DATUS_SEED_DATASOURCE=ccks_fund,sales_postgres,analytics_mysql
# Empty means "grant the current DATUS_DATASOURCE".
DATUS_SEED_DATASOURCE=
DATUS_SEED_DATASOURCE_SCHEMAS=public
DATUS_SEED_DATASOURCE_TABLES=*

# Advanced seed knobs, if needed:
# DATUS_SEED_ADMIN_USER=alice
# DATUS_SEED_READER_USER=bob
# DATUS_SEED_ADMIN_ROLE=local_admin
# DATUS_SEED_READER_ROLE=fund_reader
# DATUS_SEED_ADMIN_PERMISSIONS=*
# DATUS_SEED_READER_PERMISSIONS=module.chat,module.datasource_catalog,module.sql_executor,module.config.view,module.system.status
# DATUS_SEED_SKIP_READER_GRANT=0
