# 企业单节点 MVP 配置片段。
#
# 将需要的片段合并到 agent.yml。该文件只放企业平台相关配置；
# 普通模型、业务数据源、RAG/vector 和项目文件路径仍放在常规 agent.yml 中。
# 该配置适合本地或单节点试点，不适合多 worker / HA 生产部署。

api:
  auth_provider:
    # 企业网关不能注入签名身份 header 时使用该 provider。
    # Datus 会读取 Bearer access token，并调用 userinfo 接口换取员工身份。
    class: datus_enterprise.auth_provider:UserInfoBearerAuthProvider
    kwargs:
      userinfo_url: ${DATUS_ENTERPRISE_USERINFO_URL}
      timeout_seconds: 3.0
      user_id_field: username
      external_user_id_field: userId
      email_field: email
      display_name_field: realname
      status_field: userStatus
      allowed_statuses: ["正常"]
      default_project_id: enterprise

    # 如果企业网关可以改造，优先使用签名 header 方案：
    #
    # class: datus_enterprise.auth_provider:SignedHeaderAuthProvider
    # kwargs:
    #   secret_env: DATUS_ENTERPRISE_HEADER_SECRET
    #   default_project_id: enterprise

enterprise:
  enabled: true

  # LocalAuthorizationProvider 基于稳定 permission key 判断权限。
  # 企业模式下权限必须从 role_store 刷新，不能信任浏览器传入的 roles/permissions。
  authorization_provider:
    class: datus.api.enterprise.defaults:LocalAuthorizationProvider

  # 将 datasource grant 投影到请求级 AgentConfig clone，不能修改共享服务配置。
  config_projector:
    class: datus_enterprise.projection:DatasourceGrantProjector

  # 可选：首次登录自动创建用户。默认关闭。
  # 只有 userinfo/header provider 已是可信员工身份来源时才开启；
  # 默认角色必须预先存在，并且应该是低权限角色。
  user_auto_provisioning:
    enabled: false
    default_role_ids: []

  # 普通用户自建 OpenAI 兼容模型，默认关闭。开启前务必收窄 allowed_base_urls。
  user_model_credentials:
    custom_openai_compatible:
      enabled: false
      allowed_base_urls: ["http://localhost:8000/v1", "https://models.corp/*"]

  # 普通用户个人数据源，默认关闭。开启前务必按部署网络边界收窄 allowed_hosts。
  user_datasources:
    enabled: false
    allowed_types: [postgresql, mysql, oceanbase]
    allowed_hosts: [localhost, 127.0.0.1]
    default_ports:
      postgresql: "5432"
      mysql: "3306"
      oceanbase: "2881"

  # 单节点 metadata store。多个 store 可以共用一个 SQLite 文件，因为各自管理独立表。
  # 多 worker、滚动发布或 HA 试点前，应切换到 PostgreSQL store。
  user_store:
    class: datus.api.enterprise.defaults:SqliteEnterpriseUserStore
    kwargs:
      db_path: .datus/enterprise.db

  role_store:
    class: datus.api.enterprise.defaults:SqliteEnterpriseRoleStore
    kwargs:
      db_path: .datus/enterprise.db

  datasource_grant_store:
    class: datus.api.enterprise.defaults:SqliteEnterpriseDatasourceGrantStore
    kwargs:
      db_path: .datus/enterprise.db

  session_owner_store:
    class: datus.api.enterprise.defaults:SqliteSessionOwnerStore
    kwargs:
      db_path: .datus/enterprise.db

  audit_sink:
    class: datus.api.enterprise.defaults:SqliteAuditSink
    kwargs:
      db_path: .datus/enterprise.db

  # 可选：单进程 quota metadata。多 worker 部署需要换成共享 store。
  # 如果省略该项，已接入 quota 的路径会以 QUOTA_STORE_UNAVAILABLE fail closed。
  quota_store:
    class: datus.api.enterprise.defaults:InMemoryEnterpriseQuotaStore

  user_model_credential_store:
    class: datus.api.enterprise.defaults:SqliteUserModelCredentialStore
    kwargs:
      db_path: .datus/enterprise.db
      encryption_secret: ${DATUS_USER_MODEL_CREDENTIAL_SECRET}

  user_datasource_store:
    class: datus.api.enterprise.defaults:SqliteUserDatasourceStore
    kwargs:
      db_path: .datus/enterprise.db
      encryption_secret: ${DATUS_USER_DATASOURCE_SECRET}

# 可选：SQL policy。
# 当 datasource grant 还需要通过 SQL rewrite/deny 兜底时，配置具体 provider。
#
# agent:
#   sql_policy:
#     enabled: true
#     provider: your_package.sql_policy:YourSqlPolicyProvider
