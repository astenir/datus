# 企业 OceanBase MySQL metadata/session 配置片段。
#
# 该文件不是完整配置，也不会自动加载。请把顶层 enterprise 合并到完整
# agent.yml 的 agent: 下，再通过默认查找或 --config 加载完整文件。
# 它用于把企业 metadata、会话 owner/index
# metadata 和新会话正文/history/state 存到 OceanBase MySQL 模式。
#
# 注意：
# - 该片段覆盖 Datus 内部 enterprise metadata 与 session store。
# - agent.storage.rdb/vector 是另一套通用存储面，不会自动承接聊天会话。
# - session_body_store 不授予访问权；普通列表/history/delete/resume 仍必须
#   以 session_owner_store 的 owner metadata 作为授权入口。
# - 历史本地 AdvancedSQLiteSession .db 文件不会自动迁移到 OceanBase。
# - 生产 schema 迁移、备份恢复、滚动发布兼容仍是独立运维工作；这里仅做
#   CREATE DATABASE IF NOT EXISTS / CREATE TABLE IF NOT EXISTS bootstrap。
# - DSN、密码和 credential secret 必须通过环境变量或密钥系统注入，不能提交真实值。
#
# 本地 OceanBase CE 验证时可使用类似环境变量：
#
# DATUS_ENTERPRISE_OB_HOST=127.0.0.1
# DATUS_ENTERPRISE_OB_PORT=28811
# DATUS_ENTERPRISE_OB_USER=root@test
# DATUS_ENTERPRISE_OB_PASSWORD=testpass
# DATUS_ENTERPRISE_OB_DATABASE=datus_enterprise

enterprise:
  enabled: true

  authorization_provider:
    class: datus.api.enterprise.defaults:LocalAuthorizationProvider

  config_projector:
    class: datus_enterprise.projection:DatasourceGrantProjector

  # 普通用户自建 OpenAI 兼容模型，默认关闭。开启前务必收窄 allowed_base_urls。
  user_model_credentials:
    custom_openai_compatible:
      enabled: false
      allowed_base_urls: ["http://localhost:8000/v1", "https://models.corp/*"]

  # 普通用户个人数据源，默认关闭。开启前务必按部署网络边界收窄 allowed_hosts。
  user_datasources:
    enabled: false
    allowed_types: [postgresql, mysql, oceanbase]
    allowed_hosts: [localhost, 127.0.0.1, "*.corp"]
    default_ports:
      postgresql: "5432"
      mysql: "3306"
      oceanbase: "2881"

  # 普通用户个人 MCP，默认关闭。默认仅允许 HTTPS HTTP/SSE 且目标必须是公网地址；
  # allowed_hosts 不能为空。allow_insecure_http / allow_private_hosts 为受控放开开关，
  # 默认 false：前者允许 http:// 明文传输（凭据可能被窃听），后者允许私网/回环地址；
  # 两者独立生效，审计事件会记录当时的 policy_mode（strict/insecure_http/private_hosts/relaxed）。
  user_mcp:
    enabled: false
    allowed_hosts: []
    allow_insecure_http: false
    allow_private_hosts: false
    max_servers_per_user: 10
    max_selected_per_session: 3
    timeout_seconds: 30

  user_store:
    class: datus_enterprise.oceanbase_stores:ObEnterpriseUserStore
    kwargs:
      host: ${DATUS_ENTERPRISE_OB_HOST}
      port: ${DATUS_ENTERPRISE_OB_PORT:-2881}
      user: ${DATUS_ENTERPRISE_OB_USER}
      password: ${DATUS_ENTERPRISE_OB_PASSWORD}
      database: ${DATUS_ENTERPRISE_OB_DATABASE:-datus_enterprise}
      pool_max_size: 2

  role_store:
    class: datus_enterprise.oceanbase_stores:ObEnterpriseRoleStore
    kwargs:
      host: ${DATUS_ENTERPRISE_OB_HOST}
      port: ${DATUS_ENTERPRISE_OB_PORT:-2881}
      user: ${DATUS_ENTERPRISE_OB_USER}
      password: ${DATUS_ENTERPRISE_OB_PASSWORD}
      database: ${DATUS_ENTERPRISE_OB_DATABASE:-datus_enterprise}
      pool_max_size: 2

  datasource_grant_store:
    class: datus_enterprise.oceanbase_stores:ObEnterpriseDatasourceGrantStore
    kwargs:
      host: ${DATUS_ENTERPRISE_OB_HOST}
      port: ${DATUS_ENTERPRISE_OB_PORT:-2881}
      user: ${DATUS_ENTERPRISE_OB_USER}
      password: ${DATUS_ENTERPRISE_OB_PASSWORD}
      database: ${DATUS_ENTERPRISE_OB_DATABASE:-datus_enterprise}
      pool_max_size: 2

  agent_store:
    class: datus_enterprise.oceanbase_stores:ObEnterpriseAgentStore
    kwargs:
      host: ${DATUS_ENTERPRISE_OB_HOST}
      port: ${DATUS_ENTERPRISE_OB_PORT:-2881}
      user: ${DATUS_ENTERPRISE_OB_USER}
      password: ${DATUS_ENTERPRISE_OB_PASSWORD}
      database: ${DATUS_ENTERPRISE_OB_DATABASE:-datus_enterprise}
      pool_max_size: 2

  session_owner_store:
    class: datus_enterprise.oceanbase_stores:ObSessionOwnerStore
    kwargs:
      host: ${DATUS_ENTERPRISE_OB_HOST}
      port: ${DATUS_ENTERPRISE_OB_PORT:-2881}
      user: ${DATUS_ENTERPRISE_OB_USER}
      password: ${DATUS_ENTERPRISE_OB_PASSWORD}
      database: ${DATUS_ENTERPRISE_OB_DATABASE:-datus_enterprise}
      pool_max_size: 2

  artifact_acl_store:
    class: datus_enterprise.oceanbase_stores:ObArtifactAclStore
    kwargs:
      host: ${DATUS_ENTERPRISE_OB_HOST}
      port: ${DATUS_ENTERPRISE_OB_PORT:-2881}
      user: ${DATUS_ENTERPRISE_OB_USER}
      password: ${DATUS_ENTERPRISE_OB_PASSWORD}
      database: ${DATUS_ENTERPRISE_OB_DATABASE:-datus_enterprise}
      pool_max_size: 2

  audit_sink:
    class: datus_enterprise.oceanbase_stores:ObAuditSink
    kwargs:
      host: ${DATUS_ENTERPRISE_OB_HOST}
      port: ${DATUS_ENTERPRISE_OB_PORT:-2881}
      user: ${DATUS_ENTERPRISE_OB_USER}
      password: ${DATUS_ENTERPRISE_OB_PASSWORD}
      database: ${DATUS_ENTERPRISE_OB_DATABASE:-datus_enterprise}
      pool_max_size: 2

  quota_store:
    class: datus_enterprise.oceanbase_stores:ObEnterpriseQuotaStore
    kwargs:
      host: ${DATUS_ENTERPRISE_OB_HOST}
      port: ${DATUS_ENTERPRISE_OB_PORT:-2881}
      user: ${DATUS_ENTERPRISE_OB_USER}
      password: ${DATUS_ENTERPRISE_OB_PASSWORD}
      database: ${DATUS_ENTERPRISE_OB_DATABASE:-datus_enterprise}
      pool_max_size: 2

  secret_store:
    class: datus_enterprise.oceanbase_stores:ObEnterpriseSecretStore
    kwargs:
      host: ${DATUS_ENTERPRISE_OB_HOST}
      port: ${DATUS_ENTERPRISE_OB_PORT:-2881}
      user: ${DATUS_ENTERPRISE_OB_USER}
      password: ${DATUS_ENTERPRISE_OB_PASSWORD}
      database: ${DATUS_ENTERPRISE_OB_DATABASE:-datus_enterprise}
      pool_max_size: 2

  # 普通用户 BYOK 模型密钥。只存加密后的 API key blob，接口不会返回明文。
  # DATUS_USER_MODEL_CREDENTIAL_SECRET 至少 32 字符；发布时需要和 OB 备份一起纳入密钥恢复 runbook。
  user_model_credential_store:
    class: datus_enterprise.oceanbase_stores:ObUserModelCredentialStore
    kwargs:
      host: ${DATUS_ENTERPRISE_OB_HOST}
      port: ${DATUS_ENTERPRISE_OB_PORT:-2881}
      user: ${DATUS_ENTERPRISE_OB_USER}
      password: ${DATUS_ENTERPRISE_OB_PASSWORD}
      database: ${DATUS_ENTERPRISE_OB_DATABASE:-datus_enterprise}
      pool_max_size: 2
      encryption_secret: ${DATUS_USER_MODEL_CREDENTIAL_SECRET}

  # 普通用户个人数据源凭据。只存加密后的 password blob，接口不会返回明文。
  # DATUS_USER_DATASOURCE_SECRET 至少 32 字符；发布时需要和 OB 备份一起纳入密钥恢复 runbook。
  user_datasource_store:
    class: datus_enterprise.oceanbase_stores:ObUserDatasourceStore
    kwargs:
      host: ${DATUS_ENTERPRISE_OB_HOST}
      port: ${DATUS_ENTERPRISE_OB_PORT:-2881}
      user: ${DATUS_ENTERPRISE_OB_USER}
      password: ${DATUS_ENTERPRISE_OB_PASSWORD}
      database: ${DATUS_ENTERPRISE_OB_DATABASE:-datus_enterprise}
      pool_max_size: 2
      encryption_secret: ${DATUS_USER_DATASOURCE_SECRET}

  # 个人 MCP 静态 Bearer Token 加密存储；密钥必须随 OB 备份纳入恢复 runbook。
  user_mcp_server_store:
    class: datus_enterprise.oceanbase_stores:ObUserMcpServerStore
    kwargs:
      host: ${DATUS_ENTERPRISE_OB_HOST}
      port: ${DATUS_ENTERPRISE_OB_PORT:-2881}
      user: ${DATUS_ENTERPRISE_OB_USER}
      password: ${DATUS_ENTERPRISE_OB_PASSWORD}
      database: ${DATUS_ENTERPRISE_OB_DATABASE:-datus_enterprise}
      pool_max_size: 2
      encryption_secret: ${DATUS_USER_MCP_SECRET}

  session_body_store:
    class: datus_enterprise.oceanbase_session_store:ObSessionBodyStore
    kwargs:
      host: ${DATUS_ENTERPRISE_OB_HOST}
      port: ${DATUS_ENTERPRISE_OB_PORT:-2881}
      user: ${DATUS_ENTERPRISE_OB_USER}
      password: ${DATUS_ENTERPRISE_OB_PASSWORD}
      database: ${DATUS_ENTERPRISE_OB_DATABASE:-datus_enterprise}
      pool_max_size: 2
