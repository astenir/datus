# 企业 PostgreSQL metadata 配置片段。
#
# 将需要的片段合并到 agent.yml，用于接近生产的企业部署。
# 该文件只把企业平台 metadata store 切到 PostgreSQL；
# 普通业务 datasource、模型、RAG/vector、项目 subject/ 文件和 artifact bundle
# 仍由常规 agent.yml 与运行时路径管理。
#
# 每个 PG metadata/body store 都会持有一个 asyncpg pool。下面 9 个 metadata store
# 加上 session_body_store，在 max_size=2 时，每个 API 进程最多会打开 20 个
# enterprise PostgreSQL 连接；还要额外预留业务数据源和运维连接。
# 调整 min_size/max_size 时必须同时考虑 uvicorn worker/pod 数和 PostgreSQL max_connections。

api:
  auth_provider:
    # 企业网关不能注入签名身份 header 时使用该 provider。
    # Datus 会读取 Bearer access token，并调用 userinfo 接口换取员工身份。
    class: datus_enterprise.auth_provider:UserInfoBearerAuthProvider
    kwargs:
      userinfo_url: ${DATUS_ENTERPRISE_USERINFO_URL}
      timeout_seconds: 3.0
      user_id_field: username
      external_user_id_field: userId
      email_field: email
      display_name_field: realname
      status_field: userStatus
      allowed_statuses: ["正常"]
      default_project_id: enterprise

    # 如果企业网关可以改造，优先使用签名 header 方案：
    #
    # class: datus_enterprise.auth_provider:SignedHeaderAuthProvider
    # kwargs:
    #   secret_env: DATUS_ENTERPRISE_HEADER_SECRET
    #   default_project_id: enterprise

enterprise:
  enabled: true

  authorization_provider:
    class: datus.api.enterprise.defaults:LocalAuthorizationProvider

  config_projector:
    class: datus_enterprise.projection:DatasourceGrantProjector

  # 可选：首次登录自动创建用户。默认关闭。
  # 只有 userinfo/header provider 已是可信员工身份来源时才开启；
  # 默认角色必须预先存在，并且应该是低权限角色。
  user_auto_provisioning:
    enabled: false
    default_role_ids: []

  user_store:
    class: datus_enterprise.postgres_stores:PgEnterpriseUserStore
    kwargs:
      dsn: ${DATUS_ENTERPRISE_PG_DSN}
      min_size: 1
      max_size: 2

  role_store:
    class: datus_enterprise.postgres_stores:PgEnterpriseRoleStore
    kwargs:
      dsn: ${DATUS_ENTERPRISE_PG_DSN}
      min_size: 1
      max_size: 2

  datasource_grant_store:
    class: datus_enterprise.postgres_stores:PgEnterpriseDatasourceGrantStore
    kwargs:
      dsn: ${DATUS_ENTERPRISE_PG_DSN}
      min_size: 1
      max_size: 2

  agent_store:
    class: datus_enterprise.postgres_stores:PgEnterpriseAgentStore
    kwargs:
      dsn: ${DATUS_ENTERPRISE_PG_DSN}
      min_size: 1
      max_size: 2

  session_owner_store:
    class: datus_enterprise.postgres_stores:PgSessionOwnerStore
    kwargs:
      dsn: ${DATUS_ENTERPRISE_PG_DSN}
      min_size: 1
      max_size: 2

  # 可选，但企业多 worker 部署建议启用。
  # 它把新会话的正文/history/state 从本地 AdvancedSQLiteSession .db 文件迁到 PostgreSQL。
  # 注意它和 session_owner_store 不是一回事：
  # session_owner_store 是授权和索引 metadata；
  # session_body_store 保存 messages/items、message structure、turn usage、
  # running usage 和 system-prompt snapshot。它不会自动迁移历史 .db 文件。
  session_body_store:
    class: datus_enterprise.postgres_session_store:PgSessionBodyStore
    kwargs:
      dsn: ${DATUS_ENTERPRISE_PG_DSN}
      min_size: 1
      max_size: 2

  artifact_acl_store:
    class: datus_enterprise.postgres_stores:PgArtifactAclStore
    kwargs:
      dsn: ${DATUS_ENTERPRISE_PG_DSN}
      min_size: 1
      max_size: 2

  audit_sink:
    class: datus_enterprise.postgres_stores:PgAuditSink
    kwargs:
      dsn: ${DATUS_ENTERPRISE_PG_DSN}
      min_size: 1
      max_size: 2

  quota_store:
    class: datus_enterprise.postgres_stores:PgEnterpriseQuotaStore
    kwargs:
      dsn: ${DATUS_ENTERPRISE_PG_DSN}
      min_size: 1
      max_size: 2

  secret_store:
    class: datus_enterprise.postgres_stores:PgEnterpriseSecretStore
    kwargs:
      dsn: ${DATUS_ENTERPRISE_PG_DSN}
      min_size: 1
      max_size: 2

# 可选：SQL policy。
# 当 datasource grant 还需要通过 SQL rewrite/deny 兜底时，配置具体 provider。
#
# agent:
#   sql_policy:
#     enabled: true
#     provider: your_package.sql_policy:YourSqlPolicyProvider
